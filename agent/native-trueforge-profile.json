{
  "profile": "trueforge-native",
  "agent_name": "gate-keeper-native",
  "model_source": "agent/agent.json",
  "github_connector_name": "github",
  "github_tools": ["@read-only"],
  "mcp_approval": ["@all"],
  "config": {
    "sandbox": { "enabled": true, "file_downloads": false },
    "dynamic_sub_agents": { "enabled": true },
    "ask_user_questions": { "enabled": false },
    "generative_ui": { "enabled": false },
    "context_management": {
      "compaction": { "enabled": true },
      "large_tool_response": { "enabled": true }
    },
    "iteration_limit": 50
  },
  "release": {
    "default": "held",
    "sandbox_provider_required": true,
    "github_connector_required": true,
    "independent_budget_gateway_required": true,
    "credential_free_sandbox_required": true,
    "release_signoff_required": true,
    "production_automatic_merges": false,
    "production_automatic_deployments": false
  }
}

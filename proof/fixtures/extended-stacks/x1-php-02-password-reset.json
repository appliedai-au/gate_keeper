{
  "id": "x1-php-02-password-reset",
  "title": "PHP password reset",
  "holdout": false,
  "language": "php",
  "filename": "src/PasswordReset.php",
  "context": "Password reset. Tokens are sent by email, must be unguessable, are single-use and expire after 1 hour. Passwords are stored with password_hash.",
  "code": [
    "<?php",
    "",
    "final class PasswordReset",
    "{",
    "    public function __construct(private PDO $db) {}",
    "",
    "    public function createToken(int $userId): string",
    "    {",
    "        $token = md5(uniqid((string) $userId));",
    "        $stmt = $this->db->prepare('INSERT INTO resets (user_id, token, created_at) VALUES (?, ?, NOW())');",
    "        $stmt->execute([$userId, $token]);",
    "        return $token;",
    "    }",
    "",
    "    public function reset(string $token, string $newPassword): bool",
    "    {",
    "        $stmt = $this->db->prepare('SELECT user_id, created_at FROM resets WHERE token = ?');",
    "        $stmt->execute([$token]);",
    "        $row = $stmt->fetch(PDO::FETCH_ASSOC);",
    "        if ($row == false) {",
    "            return false;",
    "        }",
    "        if (strtotime($row['created_at']) < time() - 86400) {",
    "            return false;",
    "        }",
    "        $hash = md5($newPassword);",
    "        $this->db->prepare('UPDATE users SET password = ? WHERE id = ?')->execute([$hash, $row['user_id']]);",
    "        return true;",
    "    }",
    "}"
  ],
  "expected": [
    {
      "line": 9,
      "categories": [
        "security"
      ],
      "severity": "medium",
      "why": "md5(uniqid()) is predictable; reset tokens must come from random_bytes"
    },
    {
      "line": 23,
      "categories": [
        "bug"
      ],
      "severity": "medium",
      "why": "tokens expire after 24 hours (86400 s) instead of 1 hour"
    },
    {
      "line": 26,
      "categories": [
        "security"
      ],
      "severity": "medium",
      "why": "the new password is stored as an unsalted md5 instead of password_hash"
    },
    {
      "line": 28,
      "categories": [
        "security"
      ],
      "severity": "medium",
      "why": "the token is never deleted, so it can be reused until it expires"
    }
  ],
  "benign": []
}

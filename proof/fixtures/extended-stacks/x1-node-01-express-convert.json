{
  "id": "x1-node-01-express-convert",
  "title": "Express conversion and user API",
  "holdout": false,
  "language": "javascript",
  "filename": "src/server.js",
  "context": "Express 4 API. Rejected promises in route handlers are not caught by Express 4. The user record contains passwordHash, which must never be returned. File names come from the client.",
  "code": [
    "const express = require(\"express\");",
    "const { exec } = require(\"child_process\");",
    "const db = require(\"./db\");",
    "",
    "const app = express();",
    "app.use(express.json({ limit: \"100kb\" }));",
    "",
    "app.post(\"/convert\", (req, res) => {",
    "  const { file, format } = req.body;",
    "  exec(`convert /data/in/${file} /data/out/${file}.${format}`, (err) => {",
    "    if (err) return res.status(500).send(\"failed\");",
    "    res.send(\"ok\");",
    "  });",
    "});",
    "",
    "app.get(\"/users/:id\", async (req, res) => {",
    "  const user = await db.users.findById(req.params.id);",
    "  if (!user) return res.status(404).end();",
    "  res.json(user);",
    "});",
    "",
    "app.get(\"/health\", (req, res) => res.send(\"ok\"));",
    "",
    "app.use((err, req, res, next) => {",
    "  console.error(err);",
    "  res.status(500).json({ error: \"internal\" });",
    "});",
    "",
    "app.listen(3000);"
  ],
  "expected": [
    {
      "line": 10,
      "categories": [
        "security"
      ],
      "severity": "medium",
      "why": "shell command is built from request fields, so a crafted file name runs arbitrary commands"
    },
    {
      "line": 17,
      "categories": [
        "error-handling"
      ],
      "severity": "medium",
      "why": "a rejected lookup in an Express 4 async handler is never caught, so the request hangs and the rejection is unhandled"
    },
    {
      "line": 19,
      "categories": [
        "security"
      ],
      "severity": "medium",
      "why": "the full record is returned, including passwordHash"
    }
  ],
  "benign": []
}

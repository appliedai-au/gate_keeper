{
  "id": "x2-node-03-sessions",
  "title": "Express session login",
  "holdout": false,
  "language": "typescript",
  "filename": "src/auth.ts",
  "context": "Login with express-session. The site has user-generated content, so the session cookie must not be readable by page scripts. After login the user is sent to the `next` path, which must stay on this site.",
  "code": [
    "import express from \"express\";",
    "import session from \"express-session\";",
    "import { checkPassword, audit, touchLastLogin } from \"./users\";",
    "",
    "const app = express();",
    "app.use(express.urlencoded({ extended: false }));",
    "app.use(session({",
    "  secret: process.env.SESSION_SECRET!,",
    "  resave: false,",
    "  saveUninitialized: false,",
    "  cookie: { httpOnly: false, secure: true, sameSite: \"lax\" },",
    "}));",
    "",
    "app.post(\"/login\", async (req, res, next) => {",
    "  try {",
    "    const user = await checkPassword(req.body.email, req.body.password);",
    "    if (!user) return res.status(401).send(\"bad login\");",
    "    req.session.userId = user.id;",
    "    await audit(\"login\", user.id);",
    "    await touchLastLogin(user.id);",
    "    const target = String(req.query.next || \"/\");",
    "    res.redirect(target);",
    "  } catch (e) {",
    "    next(e);",
    "  }",
    "});",
    "",
    "app.post(\"/logout\", (req, res) => {",
    "  req.session.userId = undefined;",
    "  res.redirect(\"/\");",
    "});"
  ],
  "expected": [
    {
      "line": 11,
      "categories": [
        "security"
      ],
      "severity": "medium",
      "why": "httpOnly is false, so page scripts can read the session cookie"
    },
    {
      "line": 18,
      "categories": [
        "security"
      ],
      "severity": "medium",
      "why": "the session id is not regenerated on login (session fixation)"
    },
    {
      "line": 21,
      "categories": [
        "security"
      ],
      "severity": "medium",
      "why": "next is used without checking it is a local path, so //evil.example redirects off-site"
    },
    {
      "line": 29,
      "categories": [
        "security"
      ],
      "severity": "medium",
      "why": "logout only clears userId instead of destroying the session"
    }
  ],
  "benign": []
}

# Disposable Gate Keeper source-only qualification. No TrueForge service,
# database, model key, Git credentials, or network-capable agent executes here.
FROM caddy:2-alpine AS status-proxy
FROM node:24.19.0-bookworm-slim
COPY --from=status-proxy /usr/bin/caddy /usr/bin/caddy
# The complete proof-harness suite creates disposable Git repositories.
# Install only the git CLI (not credentials) in this test-only image.
RUN apt-get update && apt-get install --no-install-recommends -y git \
  && rm -rf /var/lib/apt/lists/*
WORKDIR /src
COPY package.json package-lock.json tsconfig.json ./
RUN npm ci --no-audit --no-fund
COPY scripts ./scripts
COPY evals ./evals
COPY tests ./tests
# Include the production proof image recipe so the qualification suite can
# verify that new proof services cannot auto-start billable inference.
COPY Dockerfile ./Dockerfile
COPY Dockerfile.proof ./Dockerfile.proof
COPY Dockerfile.v2-host ./Dockerfile.v2-host
COPY Dockerfile.v3-integrated ./Dockerfile.v3-integrated
COPY Dockerfile.status-proxy ./Dockerfile.status-proxy
COPY Dockerfile.qualify ./Dockerfile.qualify
COPY integrations ./integrations
# Deployment-contract tests also read checked-in security and rollout docs.
COPY docs ./docs
COPY agent ./agent
COPY config ./config
COPY proof ./proof
# Run the decoded-log leakage audit first. This must fail before any broader
# source suite if encoded public records disclose synthetic private markers.
RUN node --test tests/proof-log-redaction-canary.test.mjs > /tmp/gk-canary-test.log 2>&1; rc=$?; tail -n 120 /tmp/gk-canary-test.log; exit "$rc"
# Keep full test output as an isolated build artifact and print an explicit
# bounded verdict tail. Some negative-control fixtures intentionally log errors;
# only the final Node test runner exit status determines build acceptance.
RUN npm run typecheck > /tmp/gk-typecheck.log 2>&1; rc=$?; cat /tmp/gk-typecheck.log; if [ "$rc" -ne 0 ]; then exit "$rc"; fi; npm run score -- --selftest
RUN npm run test:learning-policy > /tmp/gk-full-test.log 2>&1; rc=$?; if [ "$rc" -ne 0 ]; then cat /tmp/gk-full-test.log; else tail -n 180 /tmp/gk-full-test.log; fi; exit "$rc"
RUN adduser --disabled-password --gecos '' --uid 10001 verifier
USER verifier
# Keep the isolated qualification container observable after its build-time tests.
CMD ["node","-e","console.log('Gate Keeper source-only qualification image complete');setInterval(()=>{},60000)"]


{
	admin off
	auto_https off
}

:{$PORT} {
	handle /proxy-healthz {
		respond "OK" 200
	}

	# This route carries only the independently authenticated public projection.
	# A path-only rewrite retains the query, so the inner handler can reject it.
	handle /gatekeeper/learning-v3/status {
		rewrite * /gatekeeper/learning-v2/status
		reverse_proxy http://{$UPSTREAM_HOST}:{$UPSTREAM_PORT}
	}

	# This exact new route performs its own independently scoped review auth.
	# A Learning read token never authorizes inference. Disabled inner feature = 503.
	handle /gatekeeper/reviews-v1 {
		reverse_proxy http://{$UPSTREAM_HOST}:{$UPSTREAM_PORT}
	}

	# This prefix authenticates browser sessions and signed GitHub webhooks itself.
	# No general proxy credentials or owner review capability is injected.
	@product path /gatekeeper/product-v1 /gatekeeper/product-v1/*
	handle @product {
		reverse_proxy http://{$UPSTREAM_HOST}:{$UPSTREAM_PORT}
	}

	# All original TrueForge routes retain the existing Basic Auth credentials.
	handle {
		basic_auth {
			{$BASIC_AUTH_USERNAME} {$GK_PROXY_PASSWORD_HASH}
		}
		reverse_proxy http://{$UPSTREAM_HOST}:{$UPSTREAM_PORT}
	}
}
